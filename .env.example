GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: set distinct voices so the in-app female/male choice changes the spoken voice.
ELEVENLABS_FEMALE_VOICE_ID=
ELEVENLABS_MALE_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4
# MongoDB connection string. Server-only: never prefix it with NEXT_PUBLIC_.
MONGODB_URI=
MONGODB_DB=safepath
# Signs the login cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Optional Android FCM delivery. Keep the private key server-only; never use NEXT_PUBLIC_.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
